<Window x:Class="BetterSR.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Height="420" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource WindowFg}"
        FontFamily="Microsoft YaHei, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="输出目录" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                    <TextBox x:Name="OutputDirBox" Width="320" Height="26" VerticalContentAlignment="Center" IsReadOnly="True" Background="{DynamicResource CardBg}" Foreground="{DynamicResource WindowFg}" BorderBrush="{DynamicResource CardBorder}"/>
                    <Button Content="浏览" Click="BrowseButton_Click" Margin="8,0,0,0" Width="60" Height="26" Background="{DynamicResource AccentLight}" Foreground="{DynamicResource WindowFg}" BorderThickness="0"/>
                </StackPanel>

                <TextBlock Text="FFmpeg 路径（可选，留空则自动下载）" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                    <TextBox x:Name="FfmpegPathBox" Width="320" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource CardBg}" Foreground="{DynamicResource WindowFg}" BorderBrush="{DynamicResource CardBorder}" TextChanged="FfmpegPathBox_TextChanged"/>
                    <Button Content="浏览" Click="BrowseFfmpegButton_Click" Margin="8,0,0,0" Width="60" Height="26" Background="{DynamicResource AccentLight}" Foreground="{DynamicResource WindowFg}" BorderThickness="0"/>
                </StackPanel>
                <TextBlock x:Name="FfmpegStatusText" FontSize="12" Margin="0,0,0,14" Foreground="{DynamicResource WindowFg}"/>

                <TextBlock Text="帧率 (fps)" FontWeight="SemiBold"/>
                <ComboBox x:Name="FpsCombo" Width="120" HorizontalAlignment="Left" Margin="0,6,0,14" Background="{DynamicResource CardBg}" Foreground="{DynamicResource WindowFg}" BorderBrush="{DynamicResource CardBorder}">
                    <ComboBoxItem Content="30"/>
                    <ComboBoxItem Content="60"/>
                </ComboBox>

                <TextBlock Text="视频码率 (kbps)" FontWeight="SemiBold"/>
                <ComboBox x:Name="BitrateCombo" Width="120" HorizontalAlignment="Left" Margin="0,6,0,14" Background="{DynamicResource CardBg}" Foreground="{DynamicResource WindowFg}" BorderBrush="{DynamicResource CardBorder}">
                    <ComboBoxItem Content="4000"/>
                    <ComboBoxItem Content="8000"/>
                    <ComboBoxItem Content="12000"/>
                    <ComboBoxItem Content="16000"/>
                </ComboBox>

                <CheckBox x:Name="AutostartCheck" Content="开机自启" Margin="0,6" Foreground="{DynamicResource WindowFg}"/>
                <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘" Margin="0,6" Foreground="{DynamicResource WindowFg}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Click="SaveButton_Click" Width="80" Height="32" Margin="8,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource ButtonFg}" BorderThickness="0"/>
            <Button Content="取消" Click="CancelButton_Click" Width="80" Height="32" Background="{DynamicResource AccentLight}" Foreground="{DynamicResource WindowFg}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
