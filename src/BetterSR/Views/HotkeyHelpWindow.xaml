<Window x:Class="BetterSR.Views.HotkeyHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷键帮助"
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource WindowFg}"
        FontFamily="Microsoft YaHei, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="快捷键一览" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12">
            <DataGrid x:Name="HotkeyGrid" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0" RowBackground="Transparent">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="功能" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="快捷键" Binding="{Binding KeyText}" Width="Auto" FontWeight="SemiBold"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
