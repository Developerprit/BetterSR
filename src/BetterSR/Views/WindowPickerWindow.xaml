<Window x:Class="BetterSR.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制窗口"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource WindowFg}"
        FontFamily="Microsoft YaHei, Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="选择一个窗口进行录制" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <ListBox Grid.Row="1" x:Name="WindowList" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" Foreground="{DynamicResource WindowFg}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource StatusFg}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="确认" Width="80" Height="32" Click="OkButton_Click" Margin="8,0" Background="{DynamicResource Accent}" Foreground="{DynamicResource ButtonFg}" BorderThickness="0"/>
            <Button Content="取消" Width="80" Height="32" Click="CancelButton_Click" Background="{DynamicResource AccentLight}" Foreground="{DynamicResource WindowFg}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
