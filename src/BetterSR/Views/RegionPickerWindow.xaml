<Window x:Class="BetterSR.Views.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择录制区域"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#80000000"
        WindowState="Maximized"
        Topmost="True"
        ResizeMode="NoResize">
    <Grid>
        <Canvas x:Name="OverlayCanvas" Background="Transparent" MouseDown="OverlayCanvas_MouseDown" MouseMove="OverlayCanvas_MouseMove" MouseUp="OverlayCanvas_MouseUp"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Background="#DD2D2233" CornerRadius="10" Padding="16,8">
            <TextBlock x:Name="InfoText" Text="拖拽选择区域，Enter 确认，Esc 取消" FontSize="14" Foreground="White"/>
        </Border>
    </Grid>
</Window>
